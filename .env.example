# 개발/디버그 설정 (true: 테스트 라우터 활성화 / false: 비활성화)
DEBUG=false

# postgreSQL 설정
DB_USER=multicampus_user
DB_PASSWORD=your_db_password
# Docker: postgres / EC2: your_ec2_ip
DB_HOST=postgres
DB_PORT=5432
DB_NAME=multicampus_db

# JWT 설정
SECRET_KEY=your_jwt_secret_key
ALGORITHM=HS256

# Kakao API 설정 (https://developers.kakao.com 에서 발급)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_API_URL=https://dapi.kakao.com/v2/local/geo/coord2address.json

# 내부 서비스 API URL (Docker 서비스명 기반, 변경 불필요)
MODEL_API_URL=http://model-app:8001/models/sign2text
MODEL_SERVER_URL=http://model-server:8002
MODEL_SERVER_TIMEOUT_SEC=120
MODEL_SERVER_DATABASE_URL=postgresql://multicampus_user:your_db_password@postgres:5432/multicampus_db
HADOOP_API_URL=http://hadoop-app:8003/hdfs/save_hdfs

# 재난문자 공공 API (https://www.safetydata.go.kr 에서 발급 + 서버 IP 등록 필요)
DISASTER_SERVICE_KEY=your_disaster_service_key

# Airflow 설정
AIRFLOW_FERNET_KEY=your_fernet_key_base64
AIRFLOW_SECRET_KEY=your_airflow_secret_key
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password

# Kafka 설정
# Docker: kafka:9092 / EC2: your_ec2_ip:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=True

# Redis 설정
REDIS_PASSWORD=your_redis_password
# Docker: redis / EC2: 127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379

# ── model-app 컨테이너 (볼륨: ./model:/app/model) ──────────────
# LSTM
LSTM_MODEL_PATH=/app/model/LSTM/lstm.pt
GLOSS_LABEL_PATH=/app/model/LSTM/label.csv

# ── model-server 컨테이너 (볼륨: ./model_server/assets:/app/assets) ──
# KoBART: KOBART_MODEL_DIR 우선, 없으면 KOBART_CHECKPOINT 사용
KOBART_MODEL_DIR=/app/assets/kobart/final_model_checkpoint-17800
KOBART_CHECKPOINT=/app/assets/kobart/final_model_checkpoint-17800

# FastText
FASTTEXT_MODEL_PATH=/app/assets/fasttext/cc.ko.300.bin

# 디바이스 설정 (GPU 없음 → cpu / GPU 있으면 → cuda)
DEVICE=cpu

# KoBART generation 파라미터
KOBART_MAX_NEW_TOKENS=64
KOBART_NUM_BEAMS=4

# LLM API (Google AI Studio에서 발급: https://aistudio.google.com)
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key

# HDFS 설정
HDFS_USER=hadoop
HDFS_PASSWORD=your_hdfs_password
# Docker: hadoop / EC2: your_ec2_ip
HDFS_HOST=hadoop
# Docker: 9870 / EC2: 8918
HDFS_PORT=9870
